{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Dubbing manifest v1",
  "type": "object",
  "required": ["schema_version", "lines"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,100}$"},
          "speaker": {"type": "string", "pattern": "\\S"},
          "text": {"type": "string", "pattern": "\\S"},
          "reference": {"type": "string", "pattern": "\\S"},
          "original": {"type": "string", "pattern": "\\S"},
          "scene": {"type": "string"},
          "status": {"enum": ["ready", "reviewed", "unknown", "blocked", "excluded", "silence", "nonverbal", "development"]},
          "reason": {"type": "string", "pattern": "\\S"},
          "blockers": {"type": "array"},
          "format": {
            "type": "object",
            "required": ["sample_rate", "channels", "frames"],
            "properties": {
              "sample_rate": {"type": "integer", "minimum": 1},
              "channels": {"type": "integer", "minimum": 1, "maximum": 8},
              "frames": {"type": "integer", "minimum": 1}
            }
          }
        },
        "allOf": [{
          "if": {"properties": {"status": {"enum": ["ready", "reviewed"]}}},
          "then": {
            "required": ["speaker", "text", "reference", "format"],
            "properties": {"blockers": {"maxItems": 0}}
          },
          "else": {"required": ["reason"]}
        }]
      }
    }
  }
}
